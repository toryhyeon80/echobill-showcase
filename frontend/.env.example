# EchoBill frontend — copy to .env.local if needed

# Empty = use Vite proxy to backend (recommended locally)
VITE_API_BASE_URL=

# Keep this in sync with the backend D04 input limit.
VITE_INPUT_MAX_LENGTH=500

# Public Kakao app key only. The client secret belongs on the backend.
VITE_KAKAO_REST_API_KEY=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
# Audio only: STT (8s) + parser (5s), with time for upload/network overhead.
VITE_AUDIO_TIMEOUT_MS=25000
