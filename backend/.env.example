# EchoBill backend — copy to .env and fill locally. Never commit .env.

APP_NAME=EchoBill
APP_ENV=development
DEBUG=true

# JWT (stub — replace secrets before any shared deploy)
# 운영은 32자 이상 난수 필수 (openssl rand -hex 32). 알고리즘은 코드에서 HS256 고정
JWT_SECRET=change-me-dev-only-not-for-production
# 사업자번호 암호화 키 (Fernet). 로컬 development는 비워 두면 코드의 개발용 키 사용, 운영은 필수
# BUSINESS_NUMBER_KEY=
# 세금계산서 Mock 결과: issue(모의 완료) | fail | delay
# TAX_MOCK_MODE=issue
JWT_ACCESS_TTL_HOURS=24
# DL-12 HttpOnly 쿠키 — 로컬 http 개발에서만 false, 운영은 true
AUTH_COOKIE_SECURE=false

# Kakao login (D07 / DL-21) — 실제 값은 backend/.env · Railway env에만
# 콘솔에서 클라이언트 시크릿이 켜져 있으므로 KAKAO_CLIENT_SECRET 필수
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 콘솔 Redirect URI와 글자 하나까지 같아야 한다 (FE 콜백 페이지)
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# Database (PostgreSQL on Railway; SQLite ok for local smoke)
DATABASE_URL=sqlite:///./echobill_dev.db

# CORS — Vite default
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI stubs (D01 — do not hardcode product choice as final)
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=5
# /parse에 LLM 연결 (기본 false — 켜면 실패·5초 초과 시 Rule 폴백)
# LLM_PARSE_ENABLED=false
# STT (DL-16 Whisper) — /parse-audio
# STT 업체: openai(기본) | clova(CLOVA Speech 단문 — webm·mp4는 서버에서 wav로 변환). 운영에서 바꾸면 처리방침 위탁 업체도 변경
# STT_PROVIDER=openai
# CLOVA 빌더 > 설정 > 연동 정보의 Invoke URL·Secret Key (값은 .env·Railway에만, 채팅·저장소 금지)
# CLOVA_SPEECH_INVOKE_URL=
# CLOVA_SPEECH_SECRET_KEY=
# 리턴제로 일반 STT — 업체 비교(eval/run_stt_compare.py)에서만 씀, 서버는 읽지 않음
# RTZR_CLIENT_ID=
# RTZR_CLIENT_SECRET=
# HyperCLOVA X(CLOVA Studio) — 해석 모델 비교(eval/run_baseline.py provider=hyperclova)에서만 씀, 서버는 읽지 않음
# CLOVASTUDIO_API_KEY=
# Claude(Anthropic) — 해석 모델 비교(provider=claude)에서만 씀, 서버는 읽지 않음
# ANTHROPIC_API_KEY=
# STT_MODEL=whisper-1
# STT 낱말 도움말 파일. 비우면 끔(지금과 같은 요청). 운영(Railway 이미지): /app/configs/prompts/stt_prompt_ko.txt
# 로컬(backend/에서 실행, 상대 경로는 작업 디렉터리 기준): ../configs/prompts/stt_prompt_ko.txt
# STT_PROMPT_FILE=
# 사장님 본인 확정 장부의 최근 거래처 이름을 도움말 끝에 "거래처: …"로 덧붙임. 기본 false(지금과 같은 요청)
# STT_COUNTERPARTY_HINTS=false
# STT_COUNTERPARTY_HINT_LIMIT=20
# STT 전체 호출 마감(초). LLM 5초 + 업로드 시간과 합쳐 FE 음성 요청 타임아웃(25초)보다 짧게
# STT_TIMEOUT_SECONDS=10
# STT_MAX_BYTES=5000000
# LLM_MAX_COMPLETION_TOKENS=800
# LLM_MAX_RETRIES=0
# LLM_TEMPERATURE=0
# 프롬프트 파일 경로. 비우면 저장소 루트 configs/prompts/parse_llm_system.txt
# LLM_SYSTEM_PROMPT_FILE=
# 모델이 거래 종류(판매·매입·반품)도 답함 (DL-30, 기본 false). 켜면 매입·반품 → UNSUPPORTED_TRANSACTION.
# configs/prompts/parse_llm_system_p3.txt와 함께 켤 것 (프롬프트가 transaction_type을 설명)
# LLM_TRANSACTION_TYPE=false
KO_NUMERAL_NORMALIZE=true
# LLM_POSTPROCESS: 외상 규칙은 항상, 단가 규칙은 KO_NUMERAL_NORMALIZE=true일 때만 (꺼져 있으면 시작 시 경고)
LLM_POSTPROCESS=true
# 캐스케이드 (기본 꺼짐): 의심 신호가 뜨면 두 번째 모델에도 묻고 다른 칸만 되묻기. 저장값은 운영 모델 답 그대로.
# 켜면 문장이 Google에도 전송 → 처리방침 위탁 업체에 Google 추가 후. 키 없이 켜면 서버가 시작하지 않음
# CASCADE_ENABLED=false
# CASCADE_MODEL=gemini-3.1-flash-lite
# CASCADE_TIMEOUT_SECONDS=3.0
# GEMINI_API_KEY=

# 사용자별 상한 (0 = 끔). 텍스트·음성 따로, "일" = 지난 24시간. 수치는 D09에서 확정
# PARSE_LIMIT_PER_MINUTE=0
# PARSE_LIMIT_PER_DAY=0
# AUDIO_LIMIT_PER_MINUTE=0
# AUDIO_LIMIT_PER_DAY=0

# 읽어 주기 TTS (/api/v1/voice/speak) — 같은 OPENAI_API_KEY. 말투 지시 파일 비우면 configs/prompts/tts_instructions_ko.txt
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=marin
# TTS_INSTRUCTIONS_FILE=
# TTS_MAX_CHARS=80
# TTS_TIMEOUT_SECONDS=8
# 사용자별 상한 (0 = 끔, parse·음성과 따로 셈). 운영은 분당 20 · 하루 200 (PM 10/26)
# SPEAK_LIMIT_PER_MINUTE=0
# SPEAK_LIMIT_PER_DAY=0

# Cloudflare 우회 차단 (비우면 끔). 켜는 순서: Cloudflare 헤더 먼저 → 그다음 이 값 (deploy.md)
# ORIGIN_SECRET=

# DL-31 음성 되묻기 답을 켤 칸 (비우면 끔). 로컬 FE 개발 시 예: credit,qty,total,counterparty
# VOICE_ANSWER_FIELDS=
